{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "runtime/**/*.ts",
    "scripts/**/*.ts",
    "packages/host-node/**/*.ts",
    "packages/host-remote/**/*.ts",
    "packages/sandbox-docker/**/*.ts",
    "packages/sandbox-remote/**/*.ts",
    "packages/github-local/**/*.ts",
    "packages/relay/**/*.ts",
    "packages/gateway/**/*.ts"
  ],
  "exclude": ["runtime/*.test.ts", "scripts/*.test.ts", "packages/**/*.test.ts"]
}
